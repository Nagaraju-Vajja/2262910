<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.macys.uop</groupId>
	<artifactId>op-foundation</artifactId>
	<version>2.0.57</version>
	<packaging>pom</packaging>
	<name>op-foundation</name>
	<modules>
		<module>op-dependencies</module>
		<module>util-core</module>
	</modules>

	<properties>
		<java.version>11</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<spring-boot.version>2.3.3.RELEASE</spring-boot.version>
		<spring-cloud.version>Hoxton.SR8</spring-cloud.version>
		<spring-cloud-gcp.version>1.2.5.RELEASE</spring-cloud-gcp.version>

		<maven-compiler-plugin.version>3.6.1</maven-compiler-plugin.version>
		<lombok.version>1.18.10</lombok.version>
		<joda-time.version>2.10.6</joda-time.version>
		<mapstruct.version>1.3.1.Final</mapstruct.version>
		<mapstruct-processor.version>1.3.1.Final</mapstruct-processor.version>
		<springfox-swagger2.version>3.0.0</springfox-swagger2.version>
		<springfox-swagger-ui.version>3.0.0</springfox-swagger-ui.version>
		<springfox-boot-starter.version>3.0.0</springfox-boot-starter.version>
		<problem.version>0.23.0</problem.version>
		<problem-spring-web-starter.version>0.25.2</problem-spring-web-starter.version>
		<google-cloud-spanner-hibernate-dialect.version>1.2.0</google-cloud-spanner-hibernate-dialect.version>
		<resilience4j.version>1.5.0</resilience4j.version>
		<micrometer-registry-prometheus.version>1.6.3</micrometer-registry-prometheus.version>
		<commons-io.version>2.8.0</commons-io.version>
		<json-path.version>2.5.0</json-path.version>
		<ehcache.version>2.10.6</ehcache.version>
		<commons-lang3.version>3.12.0</commons-lang3.version>

		<jacoco.maven.plugin.version>0.8.6</jacoco.maven.plugin.version>
		<powermock.version>2.0.9</powermock.version>
		<opencensus.version>0.31.1</opencensus.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-gcp-dependencies</artifactId>
				<version>${spring-cloud-gcp.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<distributionManagement>
		<repository>
			<id>MacysNexus</id>
			<layout>default</layout>
			<name>Macys Nexus Deploy Repo</name>
			<url>${releaseDistributionLocaltion}</url>
		</repository>
		<snapshotRepository>
			<id>MacysNexus</id>
			<layout>default</layout>
			<uniqueVersion>false</uniqueVersion>
			<name>Macys Nexus Deploy Repo</name>
			<url>${snapshotDistributionLocaltion}</url>
		</snapshotRepository>
		<site>
			<id>ReportsLocation</id>
			<name>Report Locations</name>
			<url>${siteDistributionLocaltion}</url>
		</site>
	</distributionManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.7</version>
				<executions>
					<execution>
						<id>default-prepare-agent</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>default-check</id>
						<phase>test</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.0</minimum>
										</limit>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.0</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.0</minimum>
										</limit>
										<limit>
											<counter>COMPLEXITY</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.0</minimum>
										</limit>
										<limit>
											<counter>METHOD</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.0</minimum>
										</limit>
										<limit>
											<counter>CLASS</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.0</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
